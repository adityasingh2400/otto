# Pipecat Cloud image for the Otto voice agent.
#
# IMPORTANT: build context must be the REPO ROOT (not apps/agent), because the agent has a
# path dependency on packages/spec. Deploy with:
#   cd apps/agent
#   pc cloud deploy --build-dir ../../ --dockerfile apps/agent/Dockerfile.pcc
# (pcc-deploy.toml supplies agent_name / secret_set / scaling.)
#
# The base image's entrypoint runs bot.py's `bot()` — our unified entrypoint handles the
# Daily transport Pipecat Cloud provides. The agent fetches its spec from ORCH_BASE_URL
# (/api/active-spec) at call time, so no spec is baked into the image.
FROM dailyco/pipecat-base:latest

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app
# Vendor the spec package INSIDE /app and repoint the path dep to it. uv rejects
# "../../packages/spec" here because ../../ escapes the project root in PCC's flat /app layout,
# so we rewrite it to a path under /app before resolving.
COPY packages/spec /app/vendor/otto-spec
COPY apps/agent/pyproject.toml apps/agent/uv.lock ./
RUN sed -i 's#\.\./\.\./packages/spec#vendor/otto-spec#' pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --no-dev

# Application code (bot.py = entrypoint, tools.py, the vendored NVIDIA ASR client).
COPY apps/agent/bot.py apps/agent/tools.py apps/agent/nvidia_stt.py ./
