# ── LineForge environment ─────────────────────────────────────────────────────
# Orchestrator runs with just ONE LLM key. Everything else is for the live call
# and the real Cekura swarm. Defaults favor reliability; sponsor swaps noted.
#
# ── $0 RECIPE (cheapest plug-and-play path) ───────────────────────────────────
#   1. LLM_PROVIDER=gemini + GEMINI_API_KEY        free Google AI Studio key (Gemma/Flash)
#   2. SWARM_MODE=static + SWARM_CONCURRENCY=2      free, instant swarm; won't hit Gemini rate limits
#   3. STT: DEEPGRAM_API_KEY ($200 free credit)    TTS: CARTESIA_API_KEY (free tier) or NVIDIA_API_KEY (free)
#   4. Phone: Twilio trial ($15); upgrade ~$20 to drop the trial preamble for a live judge call
#   5. Cekura + Daily: ask the co-hosts for hackathon credits.   AWS: optional — set a budget alarm.
#   Keep PRODUCTION_SWARM_VOLUME modest on a PAID LLM (each variation is one LLM call).

# ── LLM (server-side reasoning: extraction + self-heal patches) ───────────────
# provider: openai | anthropic | gemini | bedrock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=gemini runs the hackathon's featured open model, Gemma 4, for server-side
# reasoning (extract/heal/judge) — not latency-critical, zero risk to the live call, claims
# the DeepMind track. The live phone agent stays on the reliable default.
GEMINI_MODEL=gemma-4-31b-it
# AWS Bedrock (sponsor: AWS) — used when LLM_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# ── Swarm / eval engine ───────────────────────────────────────────────────────
# local  = LLM sim if an LLM key is set, else static checks (loop is real either way)
# static = force deterministic policy-coverage checks (free, instant — best with a rate-limited free LLM)
# cekura = real Cekura test framework (sponsor: Cekura, co-host)
SWARM_MODE=local
SWARM_CONCURRENCY=6          # lower to 1-2 on a free/rate-limited LLM tier
PASS_GATE=0.85               # activation blocked until pass rate >= this
SWARM_PERSONAS=12            # how many synthetic callers per run

# Cekura (sponsor: Cekura) — https://docs.cekura.ai/api-reference
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
CEKURA_AGENT_ID=             # the Cekura agent id (dashboard or POST /scenarios needs it)
# Easiest path: pre-create scenarios in the dashboard, then map persona id -> scenario id:
CEKURA_SCENARIO_MAP=         # e.g. {"severe_allergy":30,"large_party":31,"guess_availability":32}
CEKURA_PERSONALITY_ID=       # optional: a Cekura personality id applied when auto-creating scenarios
CEKURA_METRIC_IDS=           # optional: comma-separated metric ids, e.g. 12,13

# ── Telephony (sponsor: Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # the inbound number that goes live
PUBLIC_BASE_URL=             # ngrok/https URL Twilio webhooks hit (e.g. https://xxx.ngrok.app)
OWNER_PHONE=                 # business owner's number — gets a real SMS on bookings/escalations/refunds

# ── Voice pipeline (live call + Cekura WebRTC swarm) ──────────────────────────
# pipeline: cascaded (STT->LLM->TTS) | s2s (AWS Nova Sonic speech-to-speech; replaces STT+TTS)
PIPELINE_MODE=cascaded
# STT: deepgram | nvidia        TTS: cartesia | elevenlabs | nvidia
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# NVIDIA NIM (sponsor: NVIDIA) — Parakeet STT + Magpie TTS. https://build.nvidia.com/explore/speech
NVIDIA_API_KEY=

# Daily (sponsor: Daily/Pipecat, co-host) — WebRTC room the Cekura swarm joins
DAILY_API_KEY=
DAILY_ROOM_URL=
DAILY_ROOM_TOKEN=            # optional token for the agent's Daily room

# ── App ───────────────────────────────────────────────────────────────────────
ORCH_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ORCH_BASE_URL=http://localhost:8000
