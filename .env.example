# ── Otto environment ─────────────────────────────────────────────────────
# Orchestrator runs with just ONE LLM key. Everything else is for the live call
# and the real Cekura swarm. Defaults favor reliability; sponsor swaps noted.
#
# ── $0 RECIPE (cheapest plug-and-play path) ───────────────────────────────────
#   1. LLM_PROVIDER=gemini + GEMINI_API_KEY        free Google AI Studio key (Gemma/Flash)
#   2. SWARM_MODE=static + SWARM_CONCURRENCY=2      free, instant swarm; won't hit Gemini rate limits
#   3. STT: DEEPGRAM_API_KEY ($200 free credit)    TTS: CARTESIA_API_KEY (free tier) or NVIDIA_API_KEY (free)
#   4. Phone: Twilio trial ($15); upgrade ~$20 to drop the trial preamble for a live judge call
#   5. Cekura + Daily: ask the co-hosts for hackathon credits.   AWS: optional — set a budget alarm.
#   Keep PRODUCTION_SWARM_VOLUME modest on a PAID LLM (each variation is one LLM call).

# ── LLM (server-side reasoning: extraction + self-heal patches) ───────────────
# provider: openai | anthropic | gemini | nvidia | bedrock   (DEFAULT: nvidia / Nemotron)
LLM_PROVIDER=nvidia
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=gemini is the $0 path: server-side reasoning (extract/heal/judge) runs on an
# OPEN-WEIGHTS Gemma model via Google's free OpenAI-compatible endpoint. It's not
# latency-critical, so an open model fits perfectly — and it lines up with theme #1
# ("leveraging SOTA open-weights models"). GEMINI_MODEL takes any Gemma id your key
# supports (gemma-3-27b-it here; swap a gemma-4-* id if your account has one). The live
# phone agent stays on the reliable default (or NVIDIA NIM open-weights speech).
GEMINI_MODEL=gemma-3-27b-it
# the LIVE phone agent uses a fast Flash model on the same Gemini key (a 27B open model is too slow for voice)
AGENT_LLM_MODEL=gemini-2.5-flash-lite
# LLM_PROVIDER=nvidia runs server-side reasoning on NVIDIA Nemotron (open-weights) via NIM —
# OpenAI-compatible, so it's a base_url swap. This is the hackathon's theme #1 + the Daily/NVIDIA
# Nemotron voice blueprint LLM. One nvapi- key (free, build.nvidia.com) also powers Parakeet STT +
# Magpie TTS below. Confirm exact model ids on build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b           # server-side reasoning (extract/heal/judge) — fast MoE, verified
AGENT_NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2  # optional: a faster Nemotron for the live call
# AWS Bedrock (sponsor: AWS) — used when LLM_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# ── Swarm / eval engine ───────────────────────────────────────────────────────
# local  = LLM sim if an LLM key is set, else static checks (loop is real either way)
# static = force deterministic policy-coverage checks (free, instant — best with a rate-limited free LLM)
# cekura = real Cekura test framework (sponsor: Cekura, co-host)
SWARM_MODE=local
SWARM_CONCURRENCY=6          # lower to 1-2 on a free/rate-limited LLM tier
PASS_GATE=0.85               # activation blocked until pass rate >= this
SWARM_PERSONAS=12            # how many synthetic callers per run

# Cekura (sponsor: Cekura) — https://docs.cekura.ai/api-reference
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
CEKURA_AGENT_ID=             # the Cekura agent id (dashboard or POST /scenarios needs it)
# Easiest path: pre-create scenarios in the dashboard, then map persona id -> scenario id:
CEKURA_SCENARIO_MAP=         # e.g. {"severe_allergy":30,"large_party":31,"guess_availability":32}
CEKURA_PERSONALITY_ID=       # optional: a Cekura personality id applied when auto-creating scenarios
CEKURA_METRIC_IDS=           # optional: comma-separated metric ids, e.g. 12,13

# ── Telephony (sponsor: Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # the inbound number that goes live
PUBLIC_BASE_URL=             # ngrok/https URL Twilio webhooks hit (e.g. https://xxx.ngrok.app)
OWNER_PHONE=                 # business owner's number — gets a real SMS on bookings/escalations/refunds

# ── Voice pipeline (live call + Cekura WebRTC swarm) ──────────────────────────
# pipeline: cascaded (STT->LLM->TTS) | s2s (AWS Nova Sonic speech-to-speech; replaces STT+TTS)
PIPELINE_MODE=cascaded
# STT: deepgram | nvidia        TTS: cartesia | elevenlabs | nvidia
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# NVIDIA NIM (sponsor: NVIDIA) — Parakeet STT + Magpie TTS. https://build.nvidia.com/explore/speech
NVIDIA_API_KEY=

# ── Agent-under-test host for the Cekura swarm ────────────────────────────────
# Cekura's simulated caller needs an agent in a Daily room to call — serving THIS build's CANDIDATE
# spec (so heal's before→after is real). CEKURA_AGENT_HOST picks how that agent gets into a room:
#   static → use DAILY_ROOM_URL as-is (you keep an agent running in it, e.g. daily_runner.py).
#   pcc    → start the deployed Pipecat Cloud agent into a fresh room per round (needs PCC_API_KEY).
#   local  → provision a room on your Daily domain + spawn apps/agent/daily_runner.py against it
#            (needs DAILY_API_KEY + the agent venv; works on localhost where PCC can't reach you).
#   auto   → try static, then pcc, then local — whichever is configured (good default).
CEKURA_AGENT_HOST=auto
CEKURA_ROOM_EXP_S=600        # room/session TTL — a swarm run tears itself down after this

# Pipecat Cloud (sponsor: Daily/Pipecat, co-host) — host of the agent-under-test (host=pcc).
PCC_API_KEY=                 # Pipecat Cloud public API key (pk_…), from the Pipecat Cloud dashboard
PCC_AGENT_NAME=otto-agent    # mirrors apps/agent/pcc-deploy.toml (agent_name)
# How the PCC-hosted agent reaches THIS orchestrator to load the candidate spec — MUST be publicly
# reachable (your Render URL), not localhost. Defaults to PUBLIC_BASE_URL when left empty.
ORCH_PUBLIC_URL=

# Daily (sponsor: Daily/Pipecat, co-host) — used by host=local (provision a room) or host=static.
DAILY_API_KEY=               # needed for host=local: provisions a room on your own Daily domain
DAILY_ROOM_URL=              # set for host=static: an agent must already be running in this room
DAILY_ROOM_TOKEN=            # optional token for the static room

# ── App ───────────────────────────────────────────────────────────────────────
ORCH_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ORCH_BASE_URL=http://localhost:8000
