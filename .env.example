# ── LineForge environment ─────────────────────────────────────────────────────
# Orchestrator runs with just ONE LLM key. Everything else is for the live call
# and the real Cekura swarm. Defaults favor reliability; sponsor swaps noted.

# ── LLM (server-side reasoning: extraction + self-heal patches) ───────────────
# provider: openai | anthropic | gemini | bedrock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AWS Bedrock (sponsor: AWS) — used when LLM_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# ── Swarm / eval engine ───────────────────────────────────────────────────────
# local  = LLM plays callers + LLM-judge scores (no Cekura key needed, loop is real)
# cekura = real Cekura test framework (sponsor: Cekura, co-host)
SWARM_MODE=local
PASS_GATE=0.85               # activation blocked until pass rate >= this
SWARM_PERSONAS=12            # how many synthetic callers per run

# Cekura (sponsor: Cekura) — https://docs.cekura.ai/api-reference
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
CEKURA_AGENT_ID=             # created/registered once; see apps/orchestrator/app/cekura.py

# ── Telephony (sponsor: Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # the inbound number that goes live
PUBLIC_BASE_URL=             # ngrok/https URL Twilio webhooks hit (e.g. https://xxx.ngrok.app)

# ── Voice pipeline (live call + Cekura WebRTC swarm) ──────────────────────────
# STT: deepgram | nvidia        TTS: cartesia | elevenlabs | nvidia
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# NVIDIA NIM (sponsor: NVIDIA) — Parakeet STT + Magpie TTS. https://build.nvidia.com/explore/speech
NVIDIA_API_KEY=

# Daily (sponsor: Daily/Pipecat, co-host) — WebRTC room the Cekura swarm joins
DAILY_API_KEY=
DAILY_ROOM_URL=

# ── App ───────────────────────────────────────────────────────────────────────
ORCH_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ORCH_BASE_URL=http://localhost:8000
